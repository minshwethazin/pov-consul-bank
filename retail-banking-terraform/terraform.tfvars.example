# Copy to terraform.tfvars and edit. Never put AWS access keys here.
aws_region   = "ap-northeast-1"
project_name = "retail-bank-tf"

# REPLACE with your real public IPv4 /32. This example IP cannot access your lab.
allowed_client_cidrs = ["203.0.113.10/32"]

# First deploy HTTP, verify all three services, then enable HTTPS below.
enable_https = false

# Use a new hostname while your existing bank.hellogeolab.site lab remains live.
# domain_name     = "bank-tf.hellogeolab.site"
# route53_zone_id = "Z_REPLACE_WITH_YOUR_ZONE_ID"

# Optional: pin the AMI after the first deployment to avoid later AMI refresh.
# ami_id = "ami-REPLACE_WITH_SELECTED_AMI"

tags = {
  Environment = "lab"
}
